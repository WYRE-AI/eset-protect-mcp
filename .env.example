# ESET PROTECT (ESET Connect) API credentials. Create a dedicated API user
# in ESET Business Account: User Management > create a read-only account >
# enable the Integrations toggle. That user's email/password pair is what
# ESET Connect's OAuth token endpoint actually expects (a `password` grant -
# not client_credentials, despite the "client_id"/"client_secret" naming
# below matching this wave's standard credential shape).
ESETPROTECT_CLIENT_ID=
ESETPROTECT_CLIENT_SECRET=
# Optional: us (default), eu, de, jpn, or ca - the ESET Connect region your
# ESET Business Account was provisioned in. Each region has its own auth
# host and its own per-domain API hosts.
# Stdio and AUTH_MODE=env read the variables above. The gateway-mode compose
# service does not set them and does not use env_file.
ESETPROTECT_REGION=us

# stdio (default) or http
# MCP_TRANSPORT=stdio

# gateway: X-EsetProtect-Client-ID and X-EsetProtect-Client-Secret on each
#          /mcp request (X-EsetProtect-Region is optional). Never falls back
#          to ESETPROTECT_*. Docker image and Compose default.
# env:     use ESETPROTECT_* after X-Gateway-S2S verifies.
# AUTH_MODE=env

# Required to start the HTTP transport. Leave this empty here.
# The process logs an error and exits non-zero when this is empty or a known
# placeholder (changeme, replace-with-a-real-secret, secret, your-s2s-secret,
# and similar copied examples). Compose will not start when it is unset.
# Never commit a real value. Generate one with: openssl rand -hex 32
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. Logs a warning, does not enforce X-Gateway-S2S, and
# binds 127.0.0.1 only (a wider MCP_HTTP_HOST is ignored). A known placeholder
# secret is still rejected. Do not use in production.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address for HTTP when CONDUIT_S2S_SECRET is set. Defaults to 127.0.0.1.
# The container image sets 0.0.0.0. Without a secret, the listener is 127.0.0.1.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080
