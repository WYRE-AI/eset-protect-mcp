# ESET PROTECT (ESET Connect) API credentials. Create a dedicated API user
# in ESET Business Account: User Management > create a read-only account >
# enable the Integrations toggle. That user's email/password pair is what
# ESET Connect's OAuth token endpoint actually expects (a `password` grant -
# not client_credentials, despite the "client_id"/"client_secret" naming
# below matching this wave's standard credential shape).
ESETPROTECT_CLIENT_ID=
ESETPROTECT_CLIENT_SECRET=
# Optional: us (default), eu, de, jpn, or ca - the ESET Connect region your
# ESET Business Account was provisioned in. Each region has its own auth
# host and its own per-domain API hosts.
ESETPROTECT_REGION=us
